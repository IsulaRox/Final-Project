# ============================================================
# EfficientNetB0 Brain Tumor Classification
# Same pipeline / settings as the VGG16 script (fair comparison)
# + extra efficiency metrics (size, latency, throughput, FLOPs)
# ============================================================

import os

# ---- must be set BEFORE importing TensorFlow ----
os.environ["TF_CPP_MIN_LOG_LEVEL"] = "2"
os.environ["TF_NUM_INTRAOP_THREADS"] = "2"
os.environ["TF_NUM_INTEROP_THREADS"] = "2"
os.environ["OMP_NUM_THREADS"] = "2"
os.environ["TF_ENABLE_ONEDNN_OPTS"] = "0"

import time
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow as tf

from sklearn.metrics import (
    classification_report, confusion_matrix,
    precision_score, recall_score, f1_score, accuracy_score
)

from tensorflow.keras.applications import EfficientNetB0
from tensorflow.keras.layers import Input, GlobalAveragePooling2D, Dense, Dropout
from tensorflow.keras.models import Model
from tensorflow.keras.optimizers import Adam
from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint, ReduceLROnPlateau

try:
    tf.config.threading.set_intra_op_parallelism_threads(2)
    tf.config.threading.set_inter_op_parallelism_threads(2)
except RuntimeError:
    pass

# ============================================================
# Configuration (kept identical to the VGG16 script)
# ============================================================
CSV_FILE = "csv/standardized_dataset.csv"
IMAGE_SIZE = (224, 224)
BATCH_SIZE = 4
EPOCHS = 20
LEARNING_RATE = 0.0001
RANDOM_SEED = 42

MODEL_OUTPUT = "models/efficientnetb0_brain_tumor.keras"
RESULTS_FOLDER = "results/efficientnetb0"

os.makedirs("models", exist_ok=True)
os.makedirs(RESULTS_FOLDER, exist_ok=True)

np.random.seed(RANDOM_SEED)
tf.random.set_seed(RANDOM_SEED)

print("=" * 70)
print("EFFICIENTNETB0 BRAIN TUMOR CLASSIFICATION")
print("=" * 70)
print(f"TensorFlow version: {tf.__version__}")
print(f"Image size: {IMAGE_SIZE} | Batch: {BATCH_SIZE} | Epochs: {EPOCHS} | LR: {LEARNING_RATE}")
print("GPU:", tf.config.list_physical_devices("GPU") or "none (using CPU)")

# ============================================================
# 1. Load dataset
# ============================================================
print("\n" + "=" * 70 + "\n1. LOADING DATASET\n" + "=" * 70)

if not os.path.exists(CSV_FILE):
    raise FileNotFoundError(f"CSV file not found:\n{os.path.abspath(CSV_FILE)}")

df = pd.read_csv(CSV_FILE)
print(f"Total records: {len(df)}")
print("Columns:", df.columns.tolist())

missing_columns = [c for c in ["image_path", "label", "dataset"] if c not in df.columns]
if missing_columns:
    raise ValueError(f"Missing required columns: {missing_columns}")

label_mapping = {
    "Glioma": "Glioma Tumor", "Glioma Tumor": "Glioma Tumor",
    "Meningioma": "Meningioma Tumor", "Meningioma Tumor": "Meningioma Tumor",
    "No-tumor": "No-tumor", "Normal Brain": "No-tumor", "notumor": "No-tumor",
    "Pituitary": "Pituitary Tumor", "Pituitary tumor": "Pituitary Tumor",
    "Pituitary Tumor": "Pituitary Tumor",
}

df["label"] = df["label"].astype(str).str.strip().map(label_mapping)

before = len(df)
df = df.dropna(subset=["label"]).copy()
print(f"Removed unknown labels: {before - len(df)}")

before = len(df)
df = df.drop_duplicates(subset=["image_path", "label"]).copy()
print(f"Removed duplicates: {before - len(df)}")

CLASS_NAMES = ["Glioma Tumor", "Meningioma Tumor", "No-tumor", "Pituitary Tumor"]
NUM_CLASSES = len(CLASS_NAMES)
class_to_index = {name: i for i, name in enumerate(CLASS_NAMES)}
df["class_index"] = df["label"].map(class_to_index)

print("\nClass distribution:")
print(df["label"].value_counts())

df["dataset"] = df["dataset"].astype(str).str.strip().str.lower().replace({
    "train": "train", "training": "train",
    "validation": "validation", "valid": "validation", "val": "validation",
    "test": "test", "testing": "test",
})

train_df = df[df["dataset"] == "train"].copy()
validation_df = df[df["dataset"] == "validation"].copy()
test_df = df[df["dataset"] == "test"].copy()

total = len(df)
print("\n" + "=" * 70 + "\nDATASET SPLIT\n" + "=" * 70)
print(f"Total:      {total}")
print(f"Training:   {len(train_df)} ({len(train_df) / total * 100:.2f}%)")
print(f"Validation: {len(validation_df)} ({len(validation_df) / total * 100:.2f}%)")
print(f"Testing:    {len(test_df)} ({len(test_df) / total * 100:.2f}%)")

for name, part in [("Training", train_df), ("Validation", validation_df), ("Testing", test_df)]:
    if len(part) == 0:
        raise ValueError(f"{name} dataset is empty.")

print("\nChecking image paths...")
missing_paths = [str(p) for p in df["image_path"] if not os.path.exists(str(p))]
if missing_paths:
    print(f"WARNING: {len(missing_paths)} image paths not found. First 10:")
    for p in missing_paths[:10]:
        print(p)
    raise FileNotFoundError("Some image files cannot be found. Check image_path values.")
print("All image paths are valid.")

# ============================================================
# 2. TensorFlow datasets
# ============================================================
print("\n" + "=" * 70 + "\n2. CREATING TENSORFLOW DATASETS\n" + "=" * 70)


def load_and_preprocess_image(image_path, label):
    image = tf.io.read_file(image_path)
    image = tf.image.decode_image(image, channels=3, expand_animations=False)
    image.set_shape([None, None, 3])
    image = tf.image.resize(image, IMAGE_SIZE)
    image = tf.cast(image, tf.float32)
    # NOTE: EfficientNetB0 already contains its own rescaling/normalization
    # layers, so it expects raw 0-255 pixels. Do NOT use VGG16 preprocess_input.
    return image, label


def create_dataset(dataframe, shuffle=False):
    ds = tf.data.Dataset.from_tensor_slices(
        (dataframe["image_path"].values, dataframe["class_index"].values)
    )
    if shuffle:
        ds = ds.shuffle(min(len(dataframe), 512), seed=RANDOM_SEED, reshuffle_each_iteration=True)
    ds = ds.map(load_and_preprocess_image, num_parallel_calls=2)
    ds = ds.batch(BATCH_SIZE)
    ds = ds.prefetch(1)
    return ds


train_dataset = create_dataset(train_df, shuffle=True)
validation_dataset = create_dataset(validation_df)
test_dataset = create_dataset(test_df)
print("TensorFlow datasets created successfully.")

# ============================================================
# 3. Build EfficientNetB0 model
# ============================================================
print("\n" + "=" * 70 + "\n3. BUILDING EFFICIENTNETB0 MODEL\n" + "=" * 70)

base_model = EfficientNetB0(
    weights="imagenet",
    include_top=False,
    input_shape=(IMAGE_SIZE[0], IMAGE_SIZE[1], 3),
)
base_model.trainable = False   # frozen, same as VGG16 script
print("EfficientNetB0 base model frozen.")

inputs = Input(shape=(IMAGE_SIZE[0], IMAGE_SIZE[1], 3))
x = base_model(inputs, training=False)
x = GlobalAveragePooling2D()(x)
x = Dense(128, activation="relu")(x)
x = Dropout(0.5)(x)
outputs = Dense(NUM_CLASSES, activation="softmax")(x)

model = Model(inputs=inputs, outputs=outputs)
model.compile(
    optimizer=Adam(learning_rate=LEARNING_RATE),
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"],
)
model.summary()

trainable_params = int(np.sum([np.prod(v.shape) for v in model.trainable_variables]))
non_trainable_params = int(np.sum([np.prod(v.shape) for v in model.non_trainable_variables]))
total_params = trainable_params + non_trainable_params

print("\n" + "=" * 70 + "\nMODEL PARAMETERS\n" + "=" * 70)
print(f"Total parameters:     {total_params:,}")
print(f"Trainable parameters: {trainable_params:,}")
print(f"Non-trainable params: {non_trainable_params:,}")

# ============================================================
# 4. Callbacks
# ============================================================
checkpoint_path = os.path.join(RESULTS_FOLDER, "best_efficientnetb0.keras")

callbacks = [
    EarlyStopping(monitor="val_loss", patience=5, restore_best_weights=True, verbose=1),
    ModelCheckpoint(checkpoint_path, monitor="val_loss", save_best_only=True, verbose=1),
    ReduceLROnPlateau(monitor="val_loss", factor=0.5, patience=2, min_lr=1e-7, verbose=1),
]

# ============================================================
# 5. Train
# ============================================================
print("\n" + "=" * 70 + "\n4. STARTING EFFICIENTNETB0 TRAINING\n" + "=" * 70)

training_start = time.time()
history = model.fit(
    train_dataset,
    validation_data=validation_dataset,
    epochs=EPOCHS,
    callbacks=callbacks,
    verbose=1,
)
training_time = time.time() - training_start
epochs_run = len(history.history["loss"])
            
print(f"\nTraining completed: {training_time:.2f} s ({training_time / 60:.2f} min)")

model.save(MODEL_OUTPUT)
print(f"Model saved to: {MODEL_OUTPUT}")

# ============================================================
# 6. Test evaluation
# ============================================================
print("\n" + "=" * 70 + "\n5. TESTING MODEL\n" + "=" * 70)

t0 = time.time()
test_loss, test_accuracy = model.evaluate(test_dataset, verbose=1)
test_evaluation_time = time.time() - t0

t0 = time.time()
predictions = model.predict(test_dataset, verbose=1)
prediction_time = time.time() - t0

y_pred = np.argmax(predictions, axis=1)
y_true = test_df["class_index"].values   # test set is not shuffled, so order matches

accuracy = accuracy_score(y_true, y_pred)
precision = precision_score(y_true, y_pred, average="weighted", zero_division=0)
recall = recall_score(y_true, y_pred, average="weighted", zero_division=0)
f1 = f1_score(y_true, y_pred, average="weighted", zero_division=0)

print("\n" + "=" * 70 + "\nEFFICIENTNETB0 PERFORMANCE RESULTS\n" + "=" * 70)
print(f"Test Loss:      {test_loss:.4f}")
print(f"Test Accuracy:  {accuracy * 100:.2f}%")
print(f"Precision:      {precision * 100:.2f}%")
print(f"Recall:         {recall * 100:.2f}%")
print(f"F1 Score:       {f1 * 100:.2f}%")

report = classification_report(y_true, y_pred, target_names=CLASS_NAMES, digits=4, zero_division=0)
print("\n" + "=" * 70 + "\nCLASSIFICATION REPORT\n" + "=" * 70)
print(report)

report_path = os.path.join(RESULTS_FOLDER, "classification_report.txt")
with open(report_path, "w", encoding="utf-8") as f:
    f.write("EfficientNetB0 Brain Tumor Classification Report\n" + "=" * 60 + "\n\n")
    f.write(f"Test Accuracy: {accuracy * 100:.2f}%\nPrecision: {precision * 100:.2f}%\n")
    f.write(f"Recall: {recall * 100:.2f}%\nF1 Score: {f1 * 100:.2f}%\n\n")
    f.write(report)

# ============================================================
# 7. Efficiency metrics
# ============================================================
print("\n" + "=" * 70 + "\nEFFICIENCY METRICS\n" + "=" * 70)

model_size_mb = os.path.getsize(MODEL_OUTPUT) / (1024 ** 2)

# batch inference latency / throughput on the test set (already timed above)
latency_ms = prediction_time / len(test_df) * 1000
throughput = len(test_df) / prediction_time

# single-image latency (warm-up, then average of 50 runs)
sample_batch, _ = next(iter(test_dataset.unbatch().batch(1).take(1)))
_ = model(sample_batch, training=False)
t0 = time.time()
for _ in range(50):
    _ = model(sample_batch, training=False)
single_latency_ms = (time.time() - t0) / 50 * 1000

# FLOPs (best effort; skipped if the profiler fails on your TF version)
flops = None
try:
    from tensorflow.python.framework.convert_to_constants import convert_variables_to_constants_v2_as_graph
    concrete = tf.function(lambda inp: model(inp)).get_concrete_function(
        tf.TensorSpec([1, IMAGE_SIZE[0], IMAGE_SIZE[1], 3], tf.float32))
    _, graph_def = convert_variables_to_constants_v2_as_graph(concrete)
    with tf.Graph().as_default() as g:
        tf.graph_util.import_graph_def(graph_def, name="")
        opts = tf.compat.v1.profiler.ProfileOptionBuilder.float_operation()
        flops = tf.compat.v1.profiler.profile(graph=g, options=opts).total_float_ops
except Exception as e:
    print("FLOPs calculation skipped:", e)

print(f"Total parameters:        {total_params:,}")
print(f"Model size on disk:      {model_size_mb:.2f} MB")
print(f"Training time:           {training_time / 60:.2f} min ({training_time / epochs_run:.1f} s/epoch, {epochs_run} epochs)")
print(f"Prediction time (test):  {prediction_time:.2f} s")
print(f"Latency (batch):         {latency_ms:.2f} ms/image")
print(f"Latency (single image):  {single_latency_ms:.2f} ms")
print(f"Throughput:              {throughput:.2f} images/s")
if flops:
    print(f"FLOPs (1 image):         {flops / 1e9:.2f} GFLOPs")

# ============================================================
# 8. Plots
# ============================================================
cm = confusion_matrix(y_true, y_pred)
plt.figure(figsize=(8, 6))
plt.imshow(cm, interpolation="nearest", cmap="Blues")
plt.title("EfficientNetB0 Confusion Matrix")
plt.colorbar()
ticks = np.arange(len(CLASS_NAMES))
plt.xticks(ticks, CLASS_NAMES, rotation=45, ha="right")
plt.yticks(ticks, CLASS_NAMES)
thresh = cm.max() / 2
for i in range(cm.shape[0]):
    for j in range(cm.shape[1]):
        plt.text(j, i, str(cm[i, j]), ha="center", va="center",
                 color="white" if cm[i, j] > thresh else "black")
plt.ylabel("Actual Class")
plt.xlabel("Predicted Class")
plt.tight_layout()
confusion_matrix_path = os.path.join(RESULTS_FOLDER, "confusion_matrix.png")
plt.savefig(confusion_matrix_path, dpi=300, bbox_inches="tight")
plt.close()


def save_curve(metric, val_metric, title, ylabel, filename):
    plt.figure(figsize=(8, 6))
    plt.plot(history.history[metric], label=f"Training {ylabel}")
    plt.plot(history.history[val_metric], label=f"Validation {ylabel}")
    plt.title(title)
    plt.xlabel("Epoch")
    plt.ylabel(ylabel)
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    path = os.path.join(RESULTS_FOLDER, filename)
    plt.savefig(path, dpi=300, bbox_inches="tight")
    plt.close()
    return path


accuracy_graph_path = save_curve("accuracy", "val_accuracy",
                                 "EfficientNetB0 Training and Validation Accuracy",
                                 "Accuracy", "accuracy_curve.png")
loss_graph_path = save_curve("loss", "val_loss",
                             "EfficientNetB0 Training and Validation Loss",
                             "Loss", "loss_curve.png")

# ============================================================
# 9. Save summary (text + CSV for easy comparison with VGG16)
# ============================================================
summary_path = os.path.join(RESULTS_FOLDER, "performance_summary.txt")
with open(summary_path, "w", encoding="utf-8") as f:
    f.write("EFFICIENTNETB0 BRAIN TUMOR CLASSIFICATION\n" + "=" * 60 + "\n\n")
    f.write(f"TensorFlow: {tf.__version__}\nImage size: {IMAGE_SIZE}\nBatch size: {BATCH_SIZE}\n")
    f.write(f"Epochs (max): {EPOCHS}\nEpochs run: {epochs_run}\nLearning rate: {LEARNING_RATE}\n\n")
    f.write(f"DATASET\n{'-' * 60}\nTotal: {len(df)}\nTrain: {len(train_df)}\n")
    f.write(f"Validation: {len(validation_df)}\nTest: {len(test_df)}\n\n")
    f.write(f"MODEL\n{'-' * 60}\nTotal params: {total_params:,}\nTrainable: {trainable_params:,}\n")
    f.write(f"Non-trainable: {non_trainable_params:,}\nModel size: {model_size_mb:.2f} MB\n\n")
    f.write(f"PERFORMANCE\n{'-' * 60}\nTest loss: {test_loss:.4f}\nAccuracy: {accuracy * 100:.2f}%\n")
    f.write(f"Precision: {precision * 100:.2f}%\nRecall: {recall * 100:.2f}%\nF1: {f1 * 100:.2f}%\n\n")
    f.write(f"EFFICIENCY\n{'-' * 60}\nTraining time: {training_time / 60:.2f} min\n")
    f.write(f"Prediction time: {prediction_time:.2f} s\nEvaluation time: {test_evaluation_time:.2f} s\n")
    f.write(f"Latency (batch): {latency_ms:.2f} ms/image\nLatency (single): {single_latency_ms:.2f} ms\n")
    f.write(f"Throughput: {throughput:.2f} images/s\n")
    if flops:
        f.write(f"FLOPs: {flops / 1e9:.2f} GFLOPs\n")

pd.DataFrame({
    "Metric": ["Accuracy (%)", "Precision (%)", "Recall (%)", "F1 (%)", "Test loss",
               "Total params", "Model size (MB)", "Training time (min)",
               "Prediction time (s)", "Latency (ms/image)", "Throughput (img/s)"],
    "EfficientNetB0": [accuracy * 100, precision * 100, recall * 100, f1 * 100, test_loss,
                       total_params, model_size_mb, training_time / 60,
                       prediction_time, latency_ms, throughput],
}).to_csv(os.path.join(RESULTS_FOLDER, "summary_metrics.csv"), index=False)

print("\n" + "=" * 70 + "\nEFFICIENTNETB0 TRAINING AND EVALUATION COMPLETED\n" + "=" * 70)
print(f"Model:            {MODEL_OUTPUT}")
print(f"Best model:       {checkpoint_path}")
print(f"Results folder:   {RESULTS_FOLDER}")
print(f"Report:           {report_path}")
print(f"Confusion matrix: {confusion_matrix_path}")
print(f"Accuracy graph:   {accuracy_graph_path}")
print(f"Loss graph:       {loss_graph_path}")
print(f"Summary:          {summary_path}")
print("DONE")